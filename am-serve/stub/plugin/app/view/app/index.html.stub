<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title_html}}</title>
  <style>
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f5f7fb; color: #1f2937; }
    .app { padding: 24px; }
    .card { max-width: 720px; padding: 24px; border-radius: 16px; background: #fff; box-shadow: 0 10px 30px rgba(15, 23, 42, .08); }
    .title { margin: 0 0 12px; font-size: 22px; font-weight: 700; }
    .desc { margin: 0 0 20px; color: #64748b; }
    .button { border: 0; border-radius: 8px; padding: 10px 16px; background: #2563eb; color: #fff; cursor: pointer; }
  </style>
</head>
<body>
  <div id="app" class="app">
    <div class="card">
      <h1 class="title">{{title_html}}</h1>
      <p class="desc">这是由插件创建流程自动生成的应用入口，可在此基础上开发前端页面。</p>
      <button id="message-button" class="button">发送消息给主应用</button>
    </div>
  </div>

  <script>
    ((global) => {
      let onClick = null
      const getButton = (props) => (props.container || document).querySelector('#message-button')
      const lifecycles = {
        bootstrap: () => Promise.resolve(),
        mount: (props) => {
          const button = getButton(props)
          onClick = () => props.onMessage?.('来自 {{title_js}} 的消息')
          button?.addEventListener('click', onClick)
          return Promise.resolve()
        },
        unmount: (props) => {
          getButton(props)?.removeEventListener('click', onClick)
          onClick = null
          return Promise.resolve()
        }
      }
      global.{{name}} = lifecycles
    })(window)
  </script>
</body>
</html>
