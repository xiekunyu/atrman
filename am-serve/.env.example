# Atrman 基座环境变量样例
# 复制为 .env 后按实际环境填写；带「必填」标记的项缺失会导致功能不可用或退化成不安全默认值。
# 本文件只写键名与示例值，任何真实密钥、口令一律不要提交进仓库。

# ---------- 应用 ----------
# 调试模式：生产必须 false，true 会把调用栈、SQL 与路径细节返回给客户端
APP_DEBUG = false
APP_NAME = Atrman
# 版本号不在这里声明：唯一真源是基座根目录 manifest.json，安装与升级判定都读它
APP_TIMEZONE = Asia/Shanghai
APP_LANGUAGE = zh-CN
# 安装完成标记：安装器写入，手工装环境时置 true；false/缺省时安装向导路由保持可达
APP_INSTALL = false
# 站点对外地址（市场换票下载、回调地址拼接用），例：https://example.com
APP_URL =
# 运行环境标识，仅用于信息展示
APP_ENV = production
# 后台入口文件名（安装生成的安全入口名，如 manage_XXXX.html），用于挡住直连 index.html 的探测
APP_ENTRY_FILE = index.html

# ---------- 数据库（必填） ----------
DB_TYPE = mysql
DB_HOSTNAME = 127.0.0.1
DB_DATABASE =
DB_USERNAME =
DB_PASSWORD =
DB_PORT = 3306
DB_CHARSET = utf8mb4
# 表前缀大小写敏感，须与建库 SQL 一致
DB_PREFIX = am_

# ---------- Redis / 缓存（必填） ----------
CACHE_DRIVE = redis
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_PREFIX = atrman:

# ---------- JWT（必填，缺失即无法签发令牌） ----------
JWT_ALG = HS256
# 生产请换成独立随机值（例：php -r "echo bin2hex(random_bytes(32));"），不要复用示例
JWT_ACCESS_KEY =
# 访问令牌有效期（秒），出厂建议 3 天
JWT_ACCESS_EXP = 259200
# 必须与 ACCESS_KEY 不同的独立随机值：同一条密钥签两类令牌等于允许 refresh 令牌当 access 用（反之亦然）
JWT_REFRESH_KEY =
# 刷新令牌有效期（秒）
JWT_REFRESH_EXP = 604800

# ---------- 跨域 ----------
# 允许携带凭据跨域访问 API 的前端来源，逗号分隔、精确匹配（协议+域名+端口都要一致）
# 同源部署（前端与 API 同域）无需配置，浏览器不会发 Origin
CORS_ALLOW_ORIGINS =
# 是否放行本机来源（http(s)://localhost|127.0.0.1|[::1]:任意端口），默认 true 便于本地联调；生产建议 false
CORS_ALLOW_LOCAL = true

# ---------- 客户端真实 IP ----------
# 可信反向代理名单，支持精确 IP 与 CIDR，逗号分隔；留空表示不点名信任任何代理
# 例（nginx 与站点同机）：TRUSTED_PROXIES = 127.0.0.1
TRUSTED_PROXIES =
# 直连来自内网时是否把内网地址一律当作可信代理。默认 true 兼容「本机 nginx 反代且未配名单」的部署；
# 公网直连或已配 TRUSTED_PROXIES 时建议 false，此时代理头完全不被信任
TRUST_PROXY_INTRANET = true

# ---------- 远程下载 ----------
# 是否校验 HTTPS 证书。默认 true；仅在使用自签名证书的内网源站情况下显式置 false
DOWNLOAD_VERIFY_TLS = true

# ---------- 应用市场 ----------
# 数据来源：remote=远端市场，mock=本地模拟（仅开发）
STORE_PROVIDER = remote
STORE_REMOTE_URL = https://apps.atrman.com
STORE_REMOTE_TIMEOUT = 30
STORE_DOWNLOAD_TIMEOUT = 300
# 基座更新检测与在线升级总开关：false=不查市场、更新检查恒返回无更新、升级拒绝执行（改完需重启常驻进程）
STORE_SYSTEM_UPDATE = true
STORE_SIGN_ALG = ed25519
# 安装包验签公钥（公开值，可入库）。内置默认即官方公钥，自建市场时才需要替换
STORE_SIGN_PUBLIC_KEY = jo38imKF+SJB1rHwxBh2ItTCJPaChMA3lGgW+601IaU=
# 授权心跳间隔（秒）与宽限天数
STORE_HEARTBEAT_INTERVAL = 604800
STORE_HEARTBEAT_GRACE_DAYS = 60

# ---------- SSO 接管 ----------
# true=三方 OAuth 授权未登录流量改走会员中心登录页；false/不写=原生登录
SSO_AMWEB_ENABLED = false
# 接管目标的会员中心插件标识（入口地址由该插件 manifest 的 entry 解析）
SSO_MEMBER_APP = am_member

# ---------- 推送（未启用 webman/push 可留空） ----------
PUSH_APP_KEY =
PUSH_APP_SECRET =
