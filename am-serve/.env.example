# Atrman 基座环境变量全量字典
# 复制为 .env 后按实际环境填写。正常安装的站点无需照抄本文件：
# 安装器只会把「必填·安装写入」项写进 .env，可选项不写即走括号内的代码默认值。
#
# 身份图例：
#   【必填·安装写入】安装器收集表单或随机生成，装机即有，不要手工删
#   【可选】          不写即走代码默认值（括号注明），需要调优时再整组复制进 .env
#   【容器注入】      docker-compose.yml 的 environment 段提供，裸机 / Windows 部署不用写
#
# 本文件只写键名与示例值，任何真实密钥、口令一律不要提交进仓库（.env 已在 .gitignore）。
# 已废弃残键请勿写入：APP_KEY（旧版 JWT 兜底）、APP_VERSION / APP_RELEASE（升级器会主动清理）；
# 版本号唯一真源是基座根目录 manifest.json。

# =====================================================================
# A. 应用基础
# =====================================================================
# 【必填·安装写入】调试模式：生产必须 false，true 会把调用栈、SQL 与路径细节返回给客户端
APP_DEBUG = false
# 【必填·安装写入】
APP_TIMEZONE = Asia/Shanghai
# 【必填·安装写入】
APP_LANGUAGE = zh-CN
# 【必填·安装写入】站点标识（仅展示用途，代码不读取该键）
APP_NAME = Atrman
# 【必填·安装写入】安装完成标记：安装器置 true；false/缺省时安装向导路由保持可达
APP_INSTALL = false
# 【必填·安装写入】后台入口文件名（安装生成的安全入口名，如 manage_XXXX.html），用于挡住直连 index.html 的探测
APP_ENTRY_FILE = index.html
# 【可选，默认空】站点对外地址（市场换票下载、License 域名绑定、回调拼接用），例：https://example.com；
# 留空时运行期以请求 Host 兜底
APP_URL =
# 【可选，默认 production】运行环境标识，仅用于系统信息页展示
APP_ENV = production

# =====================================================================
# B. 数据库（整组必填，安装表单收集）
# =====================================================================
DB_TYPE = mysql
DB_HOSTNAME = 127.0.0.1
DB_DATABASE =
DB_USERNAME =
DB_PASSWORD =
# 【可选级默认，安装器同样写入】DB_PORT 默认 3306、DB_CHARSET 默认 utf8mb4
DB_PORT = 3306
DB_CHARSET = utf8mb4
# 表前缀大小写敏感，须与建库 SQL 一致（默认 am_）
DB_PREFIX = am_

# =====================================================================
# C. Redis / 缓存（整组必填，安装表单收集）
# =====================================================================
# 【可选，默认 file】缓存驱动，基座安装器固定写 redis
CACHE_DRIVE = redis
REDIS_HOST = 127.0.0.1
# 【可选级默认】REDIS_PORT 默认 6379
REDIS_PORT = 6379
REDIS_PASSWORD =
# 【可选，默认 atrman:】
REDIS_PREFIX = atrman:
# 【可选，默认 1】redis-queue 独立逻辑库：与缓存库（默认 db0）分开，避免清缓存时误伤队列消息
REDIS_QUEUE_DB = 1

# =====================================================================
# D. 安全密钥（安装器随机生成，换机勿改、随站点备份走）
# =====================================================================
# 【必填·安装写入】JWT 签名算法（默认 HS256）
JWT_ALG = HS256
# 【必填·安装写入】访问令牌签名密钥，缺失时 JwtKeyGuard 启动拦截；手工生成：php -r "echo bin2hex(random_bytes(16));"
JWT_ACCESS_KEY =
# 【必填·安装写入】访问令牌有效期（秒），出厂 3 天
JWT_ACCESS_EXP = 259200
# 【必填·安装写入】刷新令牌密钥，必须与 ACCESS_KEY 不同：同一条密钥签两类令牌等于允许 refresh 当 access 用
JWT_REFRESH_KEY =
# 【必填·安装写入】刷新令牌有效期（秒，默认 604800=7 天）
JWT_REFRESH_EXP = 604800
# 【必填·安装写入】插件备份恢复包 HMAC-SHA256 密钥，64 位十六进制；缺失时恢复功能 fail-closed 拒绝执行
# 手工生成：openssl rand -hex 32 或 php -r "echo bin2hex(random_bytes(32));"
RESTORE_PACKAGE_KEY =

# =====================================================================
# E. 进程调优（整组可选；容器部署的三项由 compose 注入，无需写进 .env）
# =====================================================================
# 【可选，默认 0=自动 min(CPU 逻辑核数, 4)】HTTP worker 数。
# 1panel/限核容器注意：容器内 cpu_count() 通常读到宿主机核数（cgroup 配额对 PHP 不可见），
# 小规格机器（≤1G 内存或限 1 vCPU）建议显式写死 1~2，改完需重启
WORKER_COUNT =
# 【容器注入】文件监控开关：留空走默认（前台启动且 Linux 开启、-d 守护关闭）；容器生产镜像显式置 false
MONITOR_FILE_ENABLED =
# 【容器注入】Workerman 日志落点：留空写 runtime/logs/stdout.log|workerman.log（裸机配 logrotate 切割）；
# 容器部署由 docker-compose 注入 /dev/stdout 与 /dev/stderr，交 Docker 日志驱动轮转
WORKERMAN_STDOUT_FILE =
WORKERMAN_LOG_FILE =

# =====================================================================
# F. 全局限流（整组可选）
# =====================================================================
# 【可选，默认 true】总开关：false 时限流中间件纯透传。注解 #[RateLimit] 与写接口默认阈值均由它收口
RATELIMIT_ENABLED = true
# 【可选，默认 120 / 60】无注解写接口（POST/PUT/DELETE/PATCH）的默认阈值：窗口内最大请求数 / 窗口秒数；
# 上传、AI 等重接口在控制器上以 #[RateLimit] 注解单独收紧，GET 默认不限流
RATELIMIT_WRITE_MAX = 120
RATELIMIT_WRITE_WINDOW = 60

# =====================================================================
# G. 可观测性（整组可选）
# =====================================================================
# 【可选，默认 false】true=default 通道输出单行 JSON（便于 ELK/Loki 采集）；文本通道始终保留，
# 可用 Log::channel('file') 显式写入
LOG_JSON = false
# 【可选，默认空=端点 404】/metrics 指标端点密钥，fail-closed 不暴露采集面；
# 抓取时带 ?token=xxx 或 Authorization: Bearer xxx，建议 32 位以上随机值
METRICS_TOKEN =
# 【可选，默认空=静默休眠】告警 webhook；同一事件 300 秒冷却只发一次
ALERT_WEBHOOK_URL =

# =====================================================================
# H. 网络：跨域 / 真实 IP / 远程下载（整组可选）
# =====================================================================
# 【可选，默认空=仅同源】允许携带凭据跨域访问 API 的前端来源，逗号分隔、精确匹配（协议+域名+端口都要一致）；
# 同源部署浏览器不会发 Origin，无需配置
CORS_ALLOW_ORIGINS =
# 【可选，默认 true】是否放行本机来源（http(s)://localhost|127.0.0.1|[::1]:任意端口），生产建议 false
CORS_ALLOW_LOCAL = true
# 【可选，默认空=不信任任何代理】可信反向代理名单，支持精确 IP 与 CIDR，逗号分隔；
# 例（nginx 与站点同机）：TRUSTED_PROXIES = 127.0.0.1
TRUSTED_PROXIES =
# 【可选，默认 true】直连来自内网时是否把内网地址一律当作可信代理。兼容「本机 nginx 反代且未配名单」；
# 公网直连或已配 TRUSTED_PROXIES 时建议 false，此时代理头完全不被信任
TRUST_PROXY_INTRANET = true
# 【可选，默认生产 true / 调试 false】是否校验 HTTPS 证书；仅自签名证书的内网源站可显式置 false
DOWNLOAD_VERIFY_TLS = true

# =====================================================================
# I. 应用市场（整组可选，全套带内置默认）
# =====================================================================
# 【可选，默认 remote】数据来源：remote=远端市场，mock=本地模拟（仅开发）
STORE_PROVIDER = remote
# 【可选，默认官方市场地址】
STORE_REMOTE_URL = https://apps.atrman.com
# 【可选，默认 30】市场请求总超时（秒）
STORE_REMOTE_TIMEOUT = 30
# 【可选，默认 3】建连超时（秒）：复用的 keep-alive 死连接在此阶段快速失败，避免干等到总超时占满 worker
STORE_REMOTE_CONNECT_TIMEOUT = 3
# 【可选，默认 5】更新检查等轻量查询的短总超时（秒）：市场抖动时快速降级，不拖垮系统信息页
STORE_REMOTE_QUERY_TIMEOUT = 5
# 【可选，默认 300】安装包下载超时（秒）
STORE_DOWNLOAD_TIMEOUT = 300
# 【可选，默认 true】基座更新检测与在线升级总开关：false=不查市场、恒返回无更新、升级拒绝执行（改完需重启）
STORE_SYSTEM_UPDATE = true
# 【可选，默认 ed25519】安装包清单签名算法
STORE_SIGN_ALG = ed25519
# 【可选，默认内置官方公钥】安装包验签公钥（公开值，可入库），自建市场时才需要替换
STORE_SIGN_PUBLIC_KEY = jo38imKF+SJB1rHwxBh2ItTCJPaChMA3lGgW+601IaU=
# 【可选，默认 strict】发布清单验签模式：strict=强校验并拦截 / shadow=只记日志不拦截 / off=关闭；
# 非 strict 启动即写审计日志并在后台展示常驻安全告警，生产必须 strict
STORE_RELEASE_MANIFEST_MODE = strict
# 【可选，默认 604800 / 60】授权心跳间隔（秒）与宽限天数
STORE_HEARTBEAT_INTERVAL = 604800
STORE_HEARTBEAT_GRACE_DAYS = 60

# =====================================================================
# J. SSO 接管（整组可选，默认即原生登录）
# =====================================================================
# 【可选，默认 false】true=三方 OAuth 授权未登录流量改走会员中心登录页；false/不写=原生登录
SSO_AMWEB_ENABLED = false
# 【可选，默认 am_member】接管目标的会员中心插件标识（入口地址由该插件 manifest 的 entry 解析）
SSO_MEMBER_APP = am_member

# =====================================================================
# K. 推送（可选，未启用 webman/push 留空即可）
# =====================================================================
PUSH_APP_KEY =
PUSH_APP_SECRET =
