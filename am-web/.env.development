# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /api

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = https://artman.shooyu.cn

# Delete console
VITE_DROP_CONSOLE = false

# 会员中心 SSO 接管：开发联调需要时置 true（默认关闭，走原生登录）
VITE_SSO_ENABLED = false