# 插件开发环境配置
VITE_PLUGIN_NAME = am_demo
# 应用部署基础路径（开发模式直接走根路径）
VITE_PLUGIN_ROOT=../am-serve/plugin/am_demo
VITE_BASE_URL = /
VITE_PORT = 3006
VITE_API_PROXY_URL = https://artman.shooyu.cn
VITE_API_URL = /api
# 会员中心入口：跨端口直连时 localStorage 不共享、无法体验完整登录闭环（仅验证跳转 URL 生成）；
# 完整闭环请用同域 host/反代联调（默认相对路径 /app/am_member 即同域形态）
VITE_MEMBER_ENTRY = /app/am_member
